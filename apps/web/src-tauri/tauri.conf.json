{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Aurelius",
  "version": "0.2.0",
  "identifier": "com.aurelius.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:4242",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self' http://localhost:4242; connect-src 'self' ipc: http://ipc.localhost http://localhost:4242 http://localhost:4243 http://127.0.0.1:4243 https://openrouter.ai https://github.com https://objects.githubusercontent.com ws://localhost:4243 ws://127.0.0.1:4243; img-src 'self' asset: http://asset.localhost http://localhost:4242 blob: data:; style-src 'unsafe-inline' 'self' http://localhost:4242; font-src 'self' http://localhost:4242 data:; script-src 'self' http://localhost:4242 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/backend-server"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "nsis/images/sidebar.bmp",
        "headerImage": "nsis/images/header.bmp"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5NzlFRDVFN0VFRTZCMTQKUldRVWErNitYdTE1T1pYSGZFakR2NG00VXlWNW5zQmVaZ2pVMGpqWmdsanh0Vm9qYUlpeG4wdnQK",
      "endpoints": [
        "https://github.com/N0Vee/AURELIUS/releases/latest/download/latest.json"
      ]
    }
  }
}
